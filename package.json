{
  "name": "openkolam",
  "version": "0.0.1",
  "description": "OpenKolam (Kolam Harness): an offline infinite-canvas web app for rule-bound sikku kolam — Idea → Prompt → Draw, manual gate editing, exact undo/redo — powered by the dotkolam reference implementation.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "keywords": [
    "kolam",
    "sikku",
    "kambi",
    "kolam-json",
    "dotkolam",
    "canvas",
    "svg",
    "generative-art"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LogicIncZo/OpenKolam.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle-app.mjs",
    "test": "tsx --test test/*.test.ts",
    "serve": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@logicinczo/dotkolam": "github:LogicIncZo/dotkolam#5d0cb564b0920bdcd2ef80298f7280bd5e5b78c1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
